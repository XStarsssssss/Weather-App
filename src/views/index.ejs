<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <title>Weather App</title>
</head>
<body>

    <div class="weather-card-container">
        <div class="glass-card">
            <h1 class="app-title">Weather App</h1>
            <p class="app-subtitle">Check the current weather worldwide</p>

            <!-- Search Form -->
            <form method="post" action="/" class="search-form">
                <div class="input-group mb-3">
                    <input type="text" class="form-control custom-input" name="city_search" placeholder="Enter city name..." autocomplete="off" required>
                    <button class="btn custom-btn" type="submit">Search</button>
                </div>
            </form>

            <!-- Weather Result Section -->
            <% if (typeof city !== 'undefined' && city !== null) { %>
                <div class="weather-result mt-4 animate-fade-in">
                    <h2 class="city-name"><%= city %></h2>
                    <div class="temp-section">
                        <h1 class="temp-value"><%= temp %></h1>
                        <span class="temp-unit">°C</span>
                    </div>
                    <p class="desc-text text-capitalize"><%= desc %></p>
                    <% if (img) { %>
                        <div class="weather-icon-con">
                            <img class="weather-icon" src="<%= img %>" alt="Weather Icon">
                        </div>
                    <% } %>
                </div>
            <% } %>

            <!-- Error Alert -->
            <% if (typeof error !== 'undefined' && error !== null) { %>
                <div class="alert alert-glass mt-4 text-center" role="alert">
                    <%= error %>
                </div>
            <% } %>
        </div>
    </div>

</body>
</html>